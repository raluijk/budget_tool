@{
    ViewData["Title"] = "Transactions History";
}

<link rel="stylesheet" href="~/css/transactionHistory.css" />

<div class="grid-parent">
    <div class="comparison-container comparison-left">
        <h1 class="graph-title" id="graph-title-left">TestLeft</h1>
        <div class="graph-container">
            <div class="preview-arrow-container" id="leftChartPrevText">
                <img src="/Images/angle-left.png" alt="Left">
                <span class="period-label"></span>
            </div>
            <img src="/Images/angle-left.png" alt="Left" class="arrow" id="leftChartPrevSelect">
            <div class="transactions-pie-chart">
                <canvas id="transactionsPieChartLeft"></canvas>
            </div>
            <div class="preview-arrow-container" id="leftChartNextText">
                <span class="period-label"></span>
                <img src="/Images/angle-right.png" alt="Right">
            </div>
            <img src="/Images/angle-right.png" alt="Right" class="arrow" id="leftChartNextSelect">
        </div>
    </div>
    <div class="comparison-container comparison-right">
        <h1 class="graph-title" id="graph-title-right">TestRight</h1>
        <div class="graph-container">
            <div class="preview-arrow-container" id="rightChartPrevText">
                <img src="/Images/angle-left.png" alt="Left">
                <span class="period-label"></span>
            </div>
            <img src="/Images/angle-left.png" alt="Left" class="arrow" id="rightChartPrevSelect">
            <div class="transactions-pie-chart">
                <canvas id="transactionsPieChartRight"></canvas>
            </div>
            <div class="preview-arrow-container" id="rightChartNextText">
                <span class="period-label"></span>
                <img src="/Images/angle-right.png" alt="Right">
            </div>
            <img src="/Images/angle-right.png" alt="Right" class="arrow" id="rightChartNextSelect">
        </div>
    </div>
</div>

<div id="yearAndMonthsMenuContainer">
    <div id="yearAndMonthsMenu">
        <div id="yearSelector" class="historySelector"></div>
        <div id="monthSelector"  class="historySelector"></div>
        <div class="button-container">
            <div id="buttonCancel" class="button button-submit">Cancel</div>
            <div id="buttonOkay" class="button button-cancel">Submit</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transactionsPage.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
}